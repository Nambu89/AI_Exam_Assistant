# =============================================================================
# AI Exam Assistant — backend environment example
# =============================================================================
# Copy to backend/.env and fill in only the block for your chosen provider.
# Every variable here maps 1:1 to a field in backend/app/config.py (Settings).
# Defaults shown are the code defaults; you only need to override what differs.
#
#   >>> With MODEL_PROVIDER=local NOTHING below the "App" block is required. <<<
#   The app runs fully offline (deterministic client + local GraphRAG), which is
#   exactly what CI uses — no secrets, no Azure.
# -----------------------------------------------------------------------------


# --------------------------------- App ---------------------------------------
APP_NAME=AI Exam Assistant
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins (the SPA dev + prod origins).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# --------------------------- Provider selection -------------------------------
# local | openai | azure_openai | foundry
MODEL_PROVIDER=local
# graphrag | foundry_iq | auto  (auto prefers Foundry IQ when a Foundry endpoint
# is configured, else falls back to local GraphRAG).
KNOWLEDGE_BACKEND=auto


# ----------------- Model deployments (GPT-5 family ONLY) ----------------------
# Project policy: GPT-5 family only, never GPT-4. In azure_openai / foundry these
# are the *deployment names* created by infra/ (see infra/main.bicep modelDeployments).
CHAT_MODEL=gpt-5.4-mini          # tutor / general reasoning
ROUTER_MODEL=gpt-5-nano          # cheap routing + GraphRAG entity extraction
REASONING_MODEL=gpt-5.5          # deep reasoning: essay + hard-question validation
JUDGE_MODEL=gpt-5-mini           # LLM-as-judge for evaluations
EMBEDDING_MODEL=text-embedding-3-large


# ------------------------------ OpenAI provider -------------------------------
# Required only when MODEL_PROVIDER=openai.
OPENAI_API_KEY=


# --------------------------- Azure OpenAI provider ----------------------------
# Required only when MODEL_PROVIDER=azure_openai.
AZURE_OPENAI_ENDPOINT=
# Prefer Entra ID / managed identity over a key. Leave blank to use
# DefaultAzureCredential (recommended); set only for key-based local testing.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21


# ------------------- Azure AI Foundry provider (recommended) ------------------
# Required only when MODEL_PROVIDER=foundry. Auth is Entra ID (no keys):
# locally via `az login`, in Azure via the user-assigned managed identity.
#
# NOTE ON PRIVATE NETWORKING: when infra is deployed with
# deployPrivateNetworking=true (the default), these endpoint URLs are UNCHANGED
# — they simply resolve to private IPs via the VNet-linked Private DNS zones.
# So no extra variable is needed. The catch: the client must run inside the VNet
# (the Container Apps environment is VNet-injected). From a laptop outside the
# VNet you must use deployPrivateNetworking=false, or connect through a
# jumpbox / VPN / private DNS forwarder to reach the private endpoints.
#
# The Foundry project endpoint. Format:
#   https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
# Azure AI Search service that backs Foundry IQ agentic retrieval + GraphRAG vectors.
AZURE_SEARCH_ENDPOINT=
# Name of the Foundry IQ knowledge base (created after corpus ingestion).
FOUNDRY_KNOWLEDGE_BASE=exam-knowledge

# When running on Azure Container Apps with a USER-ASSIGNED managed identity,
# azure-identity's DefaultAzureCredential must be told which identity to use.
# infra/ injects this automatically (the MI client id). Leave blank locally.
AZURE_CLIENT_ID=


# --------------------------------- Guardrails ---------------------------------
# Azure AI Content Safety. The AIServices (Foundry) resource is multi-service and
# already exposes Content Safety, so this endpoint equals the AIServices endpoint.
ENABLE_CONTENT_SAFETY=true
AZURE_CONTENT_SAFETY_ENDPOINT=


# ------------------------------ Observability ---------------------------------
# OpenTelemetry export to Application Insights (agent tracing). infra/ injects
# this into the Container App; not needed for local runs.
APPLICATIONINSIGHTS_CONNECTION_STRING=
