# Base URL of the FastAPI backend (used when mocks are OFF)
VITE_API_URL=http://localhost:8000

# When "true", the API client returns local fixture data and simulates SSE
# streaming so the whole UI is demoable/testable with no backend running.
# When "false", the client calls ${VITE_API_URL}/api/...
VITE_USE_MOCKS=true
