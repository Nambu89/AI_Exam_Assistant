# =============================================================================
# AI Exam Assistant — root environment example
# =============================================================================
# Copy the sections you need into a real .env (which is git-ignored).
#
#   - Backend variables also live in backend/.env.example (the backend loads
#     backend/.env at import time; see backend/app/config.py).
#   - Frontend variables (VITE_*) are read at BUILD time by Vite.
#
# The single most important switch is MODEL_PROVIDER:
#   local        -> NO Azure, NO secrets. Deterministic offline agent graph.
#                   Use this to clone-and-run and for CI. Nothing else required.
#   openai       -> OpenAI-hosted GPT-5 family (needs OPENAI_API_KEY).
#   azure_openai -> Azure OpenAI deployment (endpoint + key or Entra).
#   foundry      -> Azure AI Foundry project, Entra (managed identity) auth.
# -----------------------------------------------------------------------------


# ------------------------------- FRONTEND (Vite) -----------------------------
# Base URL the SPA calls. In local dev the FastAPI backend runs on :8000.
VITE_API_URL=http://localhost:8000/api
# Use built-in mock responses instead of a live backend (great for UI-only work).
VITE_USE_MOCKS=false


# ------------------------------- BACKEND -------------------------------------
# The full, commented backend variable list is in backend/.env.example.
# Quick start (offline, zero secrets):
MODEL_PROVIDER=local
KNOWLEDGE_BACKEND=auto
